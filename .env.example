# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/kivu_ai?schema=public"

# Gemini
GEMINI_API_KEY=""
# Optional. If unavailable for the key, KIVU AI automatically chooses a compatible Gemini model.
GEMINI_MODEL="gemini-2.5-flash"

# Session signing
AUTH_SECRET="replace-with-a-long-random-secret"

# Optional object storage
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
